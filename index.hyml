<!DOCTYPE html>
<html lang="ko">
<head>

<meta charset="UTF-8">
<title>무혼 武魂</title>

<style>

body{
    margin:0;
    background:#000;
    overflow:hidden;
}

canvas{
    display:block;
    margin:auto;
}

</style>

</head>


<body>


<canvas id="game" width="1200" height="700"></canvas>


<script>


const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");



// =================
// 키
// =================

const keys={};


window.addEventListener("keydown",e=>{

keys[e.key]=true;


if(e.code==="Numpad0")
keys["0"]=true;


});


window.addEventListener("keyup",e=>{

keys[e.key]=false;


if(e.code==="Numpad0")
keys["0"]=false;


});





// =================
// 이미지
// =================


function img(name){

let i=new Image();

i.src="./assets/"+name;

return i;

}


const arena=img("arena.png");
const red=img("red.png");
const blue=img("blue.png");
const sword=img("sword.png");
const slash=img("slash.png");
const shield=img("shield.png");
const heal=img("heal.png");





// =================
// 상태
// =================


let state="count";

let count=3;

let winner="";



setInterval(()=>{

if(state==="count"){

count--;

if(count<=0)
state="play";

}

},1000);








// =================
// 플레이어
// =================


class Player{


constructor(x,y,image,color,control,name){


this.x=x;
this.y=y;

this.image=image;

this.color=color;

this.name=name;


this.hp=5;


this.speed=13;


this.control=control;


this.cool=0;


this.attack=false;


this.inv=0;


}



update(enemy){



if(keys[this.control.left])
this.x-=this.speed;


if(keys[this.control.right])
this.x+=this.speed;


if(keys[this.control.up])
this.y-=this.speed;


if(keys[this.control.down])
this.y+=this.speed;





// 제한

this.x=Math.max(
100,
Math.min(
1100,
this.x
)
);


this.y=Math.max(
150,
Math.min(
600,
this.y
)
);




// 공격

if(
keys[this.control.attack]
&&
this.cool<=0
){

this.attack=true;

this.cool=18;

}

else{

this.attack=false;

}



if(this.cool>0)
this.cool--;



if(this.inv>0)
this.inv--;



}



draw(enemy){


ctx.save();


ctx.translate(
this.x,
this.y
);



// 무적

if(this.inv>0){

ctx.strokeStyle="#00ffff";

ctx.lineWidth=5;

ctx.beginPath();

ctx.arc(
0,
0,
60,
0,
Math.PI*2
);

ctx.stroke();

}



// 캐릭터

if(this.image.complete){

ctx.drawImage(
this.image,
-50,
-50,
100,
100
);


}

else{


ctx.fillStyle=this.color;

ctx.beginPath();

ctx.arc(
0,
0,
35,
0,
Math.PI*2
);

ctx.fill();


}





// 검

if(this.attack){


let angle=Math.atan2(
enemy.y-this.y,
enemy.x-this.x
);



ctx.rotate(angle);



if(sword.complete){

ctx.drawImage(
sword,
20,
-15,
110,
30
);


}

else{


ctx.fillStyle="#eee";

ctx.fillRect(
20,
-5,
100,
10
);


}



}



ctx.restore();



}




hit(){


if(this.inv<=0)
this.hp--;


}



}







const p1=new Player(

300,
350,
red,
"#c62828",
{
left:"a",
right:"d",
up:"w",
down:"s",
attack:"q"
},
"홍련"


);



const p2=new Player(

900,
350,
blue,
"#1565c0",
{
left:"ArrowLeft",
right:"ArrowRight",
up:"ArrowUp",
down:"ArrowDown",
attack:"0"
},
"청룡"


);










// =================
// 아이템
// =================


let item=null;



setInterval(()=>{


if(state==="play"){


item={

x:250+Math.random()*700,

y:200+Math.random()*300,


type:
Math.random()<0.5?
"shield":
"heal"

};


}


},15000);







function itemDraw(){


if(!item)return;


let icon=
item.type==="shield"?
shield:
heal;



if(icon.complete){

ctx.drawImage(
icon,
item.x-30,
item.y-30,
60,
60
);


}


}






function itemCheck(p){


if(!item)return;


let d=Math.hypot(
p.x-item.x,
p.y-item.y
);



if(d<50){


if(item.type==="shield")

p.inv=180;


else

p.hp=Math.min(
5,
p.hp+2
);


item=null;


}


}






function attackCheck(a,b){


if(!a.attack)
return;


let d=Math.hypot(
a.x-b.x,
a.y-b.y
);


if(d<120)
b.hit();



}









// =================
// 화면
// =================


function background(){


if(arena.complete){

ctx.drawImage(
arena,
0,
0,
1200,
700
);


}

else{


ctx.fillStyle="#17110c";

ctx.fillRect(
0,
0,
1200,
700
);


}



}





function ui(){


ctx.font="30px serif";

ctx.fillStyle="white";


ctx.fillText(
"🔴 홍련  "+ "❤".repeat(p1.hp),
40,
50
);


ctx.fillText(
"🔵 청룡  "+ "❤".repeat(p2.hp),
850,
50
);



}





function drawTitle(){


ctx.textAlign="center";


ctx.font="100px serif";


ctx.fillStyle="#ffd700";


ctx.shadowColor="#fff2a8";

ctx.shadowBlur=25;


ctx.fillText(
"武魂",
600,
150
);


ctx.shadowBlur=0;


}






function loop(){



background();


drawTitle();



if(state==="count"){


ctx.fillStyle="white";

ctx.font="120px serif";

ctx.fillText(
count,
600,
380
);



}



else if(state==="play"){



p1.update(p2);
p2.update(p1);



attackCheck(p1,p2);
attackCheck(p2,p1);



itemCheck(p1);
itemCheck(p2);



itemDraw();



p1.draw(p2);
p2.draw(p1);



ui();



if(p1.hp<=0){

winner="청룡";

state="end";

}



if(p2.hp<=0){

winner="홍련";

state="end";

}



}



else{


ctx.fillStyle="white";

ctx.font="80px serif";

ctx.textAlign="center";


ctx.fillText(
winner+" 승리!",
600,
350
);



}



requestAnimationFrame(loop);


}



loop();



</script>

</body>
</html>
